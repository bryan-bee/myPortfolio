unt":0,"fixableWarningCount":0,"source":"28"},{"filePath":"29","messages":"30","suppressedMessages":"31","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"32","messages":"33","suppressedMessages":"34","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"35"},{"filePath":"36","messages":"37","suppressedMessages":"38","errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"39","messages":"40","suppressedMessages":"41","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"42"},{"filePath":"43","messages":"44","suppressedMessages":"45","errorCount":0,"fatalErrorCount":0,"warningCount":4,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"46","messages":"47","suppressedMessages":"48","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"49"},{"filePath":"50","messages":"51","suppressedMessages":"52","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"53","messages":"54","suppressedMessages":"55","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},"C:\\Users\\bryan\\OneDrive\\Documents\\Projects\\myPortfolio\\src\\index.js",[],[],"C:\\Users\\bryan\\OneDrive\\Documents\\Projects\\myPortfolio\\src\\App.js",["56"],[],"import './App.sass';\r\nimport Work from './Pages/Work/Work.js';\r\nimport Interests from './Pages/Interests/Interests.js';\r\nimport Page1 from './Pages/Page1/Page1.js';\r\nimport Page2 from './Pages/Page2/Page2.js';\r\nimport Footer from './Pages/Footer/Footer.js';\r\nimport Projects from './Pages/Projects/Projects.js';\r\nimport Ti from './Pages/TeachingInvolvements/TeachingInvolvements.js';\r\n\r\nfunction App() {\r\n  return (\r\n    <div className='app_main'>\r\n\r\n      <Page1 />\r\n      <Interests />\r\n      <Work />\r\n      <Projects />\r\n      <Ti />\r\n      <Footer />\r\n\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default App;\r\n","C:\\Users\\bryan\\OneDrive\\Documents\\Projects\\myPortfolio\\src\\Pages\\Work\\Work.js",[],[],"C:\\Users\\bryan\\OneDrive\\Documents\\Projects\\myPortfolio\\src\\Pages\\Interests\\Interests.js",["57"],[],"import './Interests.sass';\r\nimport SectionHeading from '../../Components/SectionHeading/SectionHeading.js';\r\nimport Resume from '../../Components/Images/resume.pdf';\r\n\r\n\r\n\r\nfunction ShowSkills() {\r\n\r\n    const s = [\r\n    \"CLI\",\r\n    \"HTML\",\r\n    \"CSS\",\r\n    \"Bootstrap\",\r\n    \"MySQL\",\r\n    \"PostgreSQL\",\r\n    \"Git\",\r\n    \"JSP\",\r\n    \"AWS\",\r\n    \"Amazon S3\",\r\n    \"AWS Lambda\",\r\n    \"Amazon EC2\",\r\n    \"AWS Glue\",\r\n    \"Amazon Athena\",\r\n    \"Amazon Bedrock\",\r\n    \"AWS AppSync\",\r\n    \"Amazon Connect\",\r\n    \"AWS CDK\",\r\n    \"DynamoDB\",\r\n    \"Firebase Firestore\",\r\n    \"Redis\",\r\n    \"Docker\",\r\n    \"Locust\",\r\n    \"FastAPI\",\r\n    \"Flask\",\r\n    \"SQLAlchemy\",\r\n    \"React.js\",\r\n    \"pandas\",\r\n    \"Kafka\",\r\n    \"NumPy\",\r\n    \"Matplotlib\"\r\n];\r\n\r\n    return (\r\n      <div className='interests_items_skills'>\r\n        {s.map(i => (\r\n          <a className='interests_items_skills_s fs1'>{i}</a>\r\n        ))}\r\n      </div>\r\n    )\r\n}\r\nfunction ShowSocials() {\r\n\r\n    const s = [\r\n      {\r\n        name: 'Résumé',\r\n        link: Resume\r\n      },\r\n      {\r\n        name: 'GitHub',\r\n        link: 'https://github.com/bryan-bee'\r\n      },\r\n      {\r\n        name: 'LinkedIn',\r\n        link: 'https://www.linkedin.com/in/bryan-bee/'\r\n      }\r\n    ];\r\n\r\n    return (\r\n      <div className='interests_items_socials'>\r\n        {s.map(i => (\r\n          <a className='interests_items_socials_s fs1' href={i.link} target='_blank' rel='noopener noreferrer'>{i.name}</a>\r\n        ))}\r\n      </div>\r\n    )\r\n\r\n}\r\n\r\n\r\n\r\nfunction Interests() {\r\n  return (\r\n    <div className='interests_main' id='interests'>\r\n\r\n\r\n\r\n      <SectionHeading text='About Me' color='rgb(216, 214, 221)' />\r\n\r\n      <div className='interests'>\r\n\r\n\r\n        <div className='interests_1 fs1'>\r\n            Hi, nice to meet you! I'm a software engineer and Computer Science graduate from <b className=\"calstate-la\">CalState Los Angeles</b> where I graduated summa cum laude. I'm naturally curious and enjoy understanding how systems work, improving them, and continuously expanding my skills as an engineer.\r\n            <br/><br/>\r\n            My main interests are backend software engineering, cloud technologies, distributed systems, and building scalable applications. I enjoy working on projects that push me beyond what I already know, especially when they involve system design, performance optimization, APIs, databases, or real-time systems.\r\n            <br/><br/>\r\n            I'm also passionate about teaching and mentorship. I enjoy breaking down complex technical concepts into approachable explanations and helping others develop the confidence to solve problems independently. That passion led me to found TIPSE, Technical Interview Preparation for Software Engineers, a student organization focused on helping computer science students strengthen their data structures, algorithms, technical interview, and problem-solving skills.\r\n            <br></br>\r\n            Whether I'm building software, learning a new technology, or mentoring others, I enjoy tackling challenging problems and creating things that have a meaningful real-world impact.\r\n        </div>\r\n        <div className='interests_2'>\r\n          <div className='interests_2_intro1 fontblack fs1'><b>Technologies and Tools I am familiar with:</b></div>\r\n          <ShowSkills />\r\n          <div className='interests_2_intro2 fontblack fs1'><b>Contact and socials:</b></div>\r\n          <ShowSocials />\r\n        </div>\r\n\r\n\r\n\r\n      </div>\r\n\r\n\r\n\r\n\r\n    </div>\r\n  )\r\n}\r\n\r\nexport default Interests;\r\n","C:\\Users\\bryan\\OneDrive\\Documents\\Projects\\myPortfolio\\src\\Pages\\Page2\\Page2.js",["58","59"],[],"C:\\Users\\bryan\\OneDrive\\Documents\\Projects\\myPortfolio\\src\\Pages\\Footer\\Footer.js",["60"],[],"import './Footer.sass'\r\nimport Resume from '../../Components/Images/resume.pdf';\r\n\r\n\r\nfunction ShowSocials() {\r\n\r\n    const s = [\r\n      {\r\n        name: 'Resume',\r\n        link: Resume,\r\n      },\r\n      {\r\n        name: 'GitHub',\r\n        link: 'https://github.com/bryan-bee'\r\n      },\r\n      {\r\n        name: 'LinkedIn',\r\n        link: 'https://www.linkedin.com/in/bryan-bee/'\r\n      }\r\n    ];\r\n\r\n    return (\r\n      <div className='footer_socials'>\r\n        {s.map(i => (\r\n          <a className='footer_socials_button fs1' href={i.link} target='_blank' rel='noopener noreferrer'>{i.name}</a>\r\n        ))}\r\n      </div>\r\n    )\r\n\r\n}\r\n\r\n\r\nfunction Footer() {\r\n  return (\r\n    <div className='footer_main'>\r\n\r\n      <div className='footer'>\r\n\r\n        <a className='footer_name fs3' href={'#'}><b>Bryan Bee</b></a>\r\n        <div className='footer_text fs1'>Thanks for visiting!</div>\r\n\r\n        <ShowSocials />\r\n\r\n      </div>\r\n\r\n\r\n    </div>\r\n  )\r\n}\r\n\r\n\r\nexport default Footer;\r\n","C:\\Users\\bryan\\OneDrive\\Documents\\Projects\\myPortfolio\\src\\Pages\\Page1\\Page1.js",["61","62","63","64"],[],"C:\\Users\\bryan\\OneDrive\\Documents\\Projects\\myPortfolio\\src\\Pages\\TeachingInvolvements\\TeachingInvolvements.js",["65"],[],"import './TeachingInvolvements.sass';\r\nimport SectionHeading from '../../Components/SectionHeading/SectionHeading.js';\r\nimport Logo from '../../Components/Images/logo.jpg';\r\nimport STEM from '../../Components/Images/STEM.png';\r\n\r\nfunction ShowTi() {\r\n  const ti = [\r\n    {\r\n      place:'Cal State LA Technical Intervew Preparation for Software Engineers (TIPSE)',\r\n      title:'Founder and President',\r\n      date:'Sep 2022 - May 2024',\r\n      content:[\r\n        '● Founded and led a student organization to help aspiring software engineers prepare for technical interviews.',\r\n        '● Responsible for organizing meetings for members, leading sessions using online resources, facilitating mock interviews, and teaching members common technical interview topics such as BFS/DFS, two-pointers, etc'\r\n      ],\r\n      image: Logo,\r\n    },\r\n    {\r\n      place:'STEM Advantage Program',\r\n      title:'Scholar',\r\n      date:'October 2022 - Present',\r\n      content:[\r\n        '● Cultivated a mentorship relationship with a STEM industry professional with a biweekly touch-base',\r\n        '● Participates in professional development workshops and industry career panels.'\r\n      ],\r\n      image: STEM,\r\n    },\r\n  ];\r\n\r\n  return (\r\n    <div className='ti_items'>\r\n\r\n      {ti.map(i => (\r\n        <div className='ti_items_card'>\r\n\r\n          <img src={i.image} className='ti_items_card_image' /><br/>\r\n          <a href={i.link} className='ti_items_card_link fs2' target='_blank' rel='noopener noreferrer' style={{fontWeight: 'bold'}}>{i.place}</a>\r\n          <div className='ti_items_card_title fs1'>{i.title}</div>\r\n          <div className='ti_items_card_date fs1'>{i.date}</div>\r\n          {i.content.map(j => (\r\n            <ul>\r\n            <li className='ti_items_card_maintext fs1'>{j}</li>\r\n            </ul>\r\n          ))}\r\n\r\n        </div>\r\n      ))}\r\n\r\n\r\n    </div>\r\n  );\r\n}\r\n\r\n\r\n\r\nfunction Ti() {\r\n  return (\r\n    <div className='ti_main' id='misc'>\r\n\r\n      <div className='ti'>\r\n\r\n        <SectionHeading text='Miscellaneous Involvements' color='white' />\r\n        <ShowTi />\r\n\r\n      </div>\r\n\r\n    </div>\r\n  )\r\n}\r\n\r\n\r\nexport default Ti;\r\n","C:\\Users\\bryan\\OneDrive\\Documents\\Projects\\myPortfolio\\src\\Pages\\Projects\\Projects.js",[],[],"C:\\Users\\bryan\\OneDrive\\Documents\\Projects\\myPortfolio\\src\\Components\\SectionHeading\\SectionHeading.js",[],[],{"ruleId":"66","severity":1,"message":"67","line":5,"column":8,"nodeType":"68","messageId":"69","endLine":5,"endColumn":13},{"ruleId":"70","severity":1,"message":"71","line":46,"column":11,"nodeType":"72","endLine":46,"endColumn":55},{"ruleId":"73","severity":1,"message":"74","line":64,"column":13,"nodeType":"72","endLine":64,"endColumn":71},{"ruleId":"75","severity":1,"message":"76","line":83,"column":9,"nodeType":"72","messageId":"77","endLine":83,"endColumn":31},{"ruleId":"70","severity":1,"message":"78","line":39,"column":9,"nodeType":"72","endLine":39,"endColumn":51},{"ruleId":"66","severity":1,"message":"79","line":4,"column":8,"nodeType":"68","messageId":"69","endLine":4,"endColumn":22},{"ruleId":"73","severity":1,"message":"74","line":53,"column":13,"nodeType":"72","endLine":53,"endColumn":71},{"ruleId":"70","severity":1,"message":"78","line":70,"column":9,"nodeType":"72","endLine":70,"endColumn":54},{"ruleId":"75","severity":1,"message":"80","line":80,"column":9,"nodeType":"72","messageId":"77","endLine":80,"endColumn":31},{"ruleId":"73","severity":1,"message":"74","line":36,"column":11,"nodeType":"72","endLine":36,"endColumn":64},"no-unused-vars","'Page2' is defined but never used.","Identifier","unusedVar","jsx-a11y/anchor-is-valid","The href attribute is required for an anchor to be keyboard accessible. Provide a valid, navigable address as the href value. If you cannot provide an href, but still need the element to resemble a link, use a button and change it with appropriate styles. Learn more: https://github.com/jsx-eslint/eslint-plugin-jsx-a11y/blob/HEAD/docs/rules/anchor-is-valid.md","JSXOpeningElement","jsx-a11y/alt-text","img elements must have an alt prop, either with meaningful text, or an empty string for decorative images.","react/jsx-pascal-case","Imported JSX component ShowContents_Page2 must be in PascalCase or SCREAMING_SNAKE_CASE","usePascalOrSnakeCase","The href attribute requires a valid value to be accessible. Provide a valid, navigable address as the href value. If you cannot provide a valid href, but still need the element to resemble a link, use a button and change it with appropriate styles. Learn more: https://github.com/jsx-eslint/eslint-plugin-jsx-a11y/blob/HEAD/docs/rules/anchor-is-valid.md","'SectionHeading' is defined but never used.","Imported JSX component ShowContents_Page1 must be in PascalCase or SCREAMING_SNAKE_CASE"]